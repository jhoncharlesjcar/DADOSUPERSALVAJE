# Acceso developer mediante Supabase Auth (proveedor predeterminado).
ADMIN_AUTH_PROVIDER=supabase
SUPABASE_URL=
# Clave publishable o anon del proyecto. Nunca usar service_role para este login.
SUPABASE_PUBLISHABLE_KEY=

# Solo para compatibilidad explícita con ADMIN_AUTH_PROVIDER=legacy.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Obligatorio para las sesiones de jugadores DNI/PIN, independiente de Supabase Auth.
PLAYER_SESSION_SECRET=

# Dinero real permanece deshabilitado. Nunca use variables NEXT_PUBLIC para secretos.
DINERO_REAL_HABILITADO=false
# Céntimos ficticios para nuevas cuentas (0 si se omite). No es una recarga real.
DEMO_WELCOME_CENTIMOS=0
ONLINE_MODE_ENABLED=true

# Conexión PostgreSQL del servidor, con TLS y rol autorizado. No se consulta al compilar.
DATABASE_URL=
# Índice efímero opcional en desarrollo; la cola durable reside en PostgreSQL.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# TODO(DECISIÓN): configurar antes de habilitar búsqueda/liquidación; sin valores inventados.
ELO_K=
MATCHMAKING_MAX_RANGE=
CONFIRMATION_SECONDS=
CONFIRMATION_PENALTY_SECONDS=
TEAM_MAX_RATING_DIFFERENCE=
# Sin estos dos parámetros batalla espera diez jugadores.
BATTLE_MIN_PLAYERS=
BATTLE_WAIT_SECONDS=
# Invocación autenticada de POST /api/pagos/conciliacion desde scheduler diario.
CONCILIACION_CRON_SECRET=
APP_SERVER_URL=
PAYMENT_PROVIDER=
# Opcional: PostgreSQL LOCAL con permiso CREATEDB para la prueba de 100 conexiones.
# La prueba crea/elimina únicamente una base de prueba aleatoria, nunca la base de la URL.
PGTEST_ADMIN_URL=

# Origen público HTTPS usado para metadatos y tarjetas sociales.
SITE_URL=https://juego.ejemplo.com
