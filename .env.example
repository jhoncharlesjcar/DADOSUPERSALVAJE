# Obligatorios en producción. Use valores únicos y guárdelos en el gestor de secretos del hosting.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
PLAYER_SESSION_SECRET=

# Saldo promocional inicial para nuevas cuentas, expresado en soles.
WELCOME_CREDITS=100
ONLINE_MODE_ENABLED=true

# Ruta absoluta a un volumen persistente cuando se ejecute con SQLite en un solo servidor.
DATABASE_PATH=

# Origen público HTTPS usado para metadatos y tarjetas sociales.
SITE_URL=https://juego.ejemplo.com
